// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id           String   @id @default(uuid())
  namaLengkap  String
  email        String   @unique
  password     String
  // Relasi ke tiket bisa ditambahkan nanti
}

model Gunung {
  id         String       @id @default(uuid())
  nama       String       
  kuota      Int
  jalur      String[]
  deskripsi  String
  gambar     String       // bisa URL gambar
  harga      Int
  peraturan  Peraturan[]  // Relasi ke banyak peraturan
  // Relasi ke jadwal pendakian bisa ditambahkan nanti
}

model Peraturan {
  id        String   @id @default(uuid())
  isi       String   // isi atau deskripsi peraturan
  gunungId  String
  gunung    Gunung   @relation(fields: [gunungId], references: [id])
}

model Pemesanan {
  id              String           @id @default(uuid())
  mountainId      String
  tanggalMasuk    DateTime
  tanggalKeluar   DateTime
  jumlahPemesan   Int
  createdAt       DateTime         @default(now())

  anggotaPemesan  AnggotaPemesan[] // Relasi one-to-many
}

model AnggotaPemesan {
  id              String     @id @default(uuid())
  pemesananId     String
  pemesanan       Pemesanan  @relation(fields: [pemesananId], references: [id], onDelete: Cascade)

  email           String
  nama            String
  noIdentitas     String
  nomorTelepon    String
  jenisKelamin    String     // Misal: "Laki-laki", "Perempuan"
  tempatLahir     String?
  tanggalLahir    DateTime?
  isCompanion     Boolean    @default(false)
  fileKtp         String?    @db.Text // data URL foto/scan KTP (opsional)
}

model TripPlan {
  id           String          @id @default(uuid())
  mountainId   String
  mountainName String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members      TripMember[]
  groupItems   TripGroupItem[]
}

model TripMember {
  id         String             @id @default(uuid())
  tripPlanId String
  tripPlan   TripPlan           @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  name       String
  order      Int

  personalItems TripPersonalItem[]
}

model TripGroupItem {
  id         String   @id @default(uuid())
  tripPlanId String
  tripPlan   TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  imageUrl   String?  @db.Text
  createdAt  DateTime @default(now())
}

model TripPersonalItem {
  id        String     @id @default(uuid())
  memberId  String
  member    TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  checked   Boolean    @default(false)
  imageUrl  String?    @db.Text
  createdAt DateTime   @default(now())
}


