// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  namaLengkap  String
  password     String
  email        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  bookings     Booking[]
  notifications Notifikasi[]
}

model Gunung {
  id              String   @id @default(uuid())
  nama            String   @map("name")
  kuota           Int      @map("quota_per_day")
  deskripsi       String?  @map("description")
  urlGambar       String?  @map("image_url")
  heroImageUrl    String?  @map("hero_image_url")
  harga           Int      @map("price_per_person")
  lokasi          String   @map("location")
  provinsi        String   @map("province")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  peraturan       Peraturan[]
  bookings        Booking[]
  galeriGunung    GaleriGunung[]
  jalur           Jalur[]
  kuotaHarian     KuotaHarian[]
  
  @@map("mountains")
}

model Peraturan {
  id        String   @id @default(uuid())
  isi       String   @map("term_text")
  gunungId  String   @map("mountain_id")
  orderIndex Int     @default(0) @map("order_index")
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  gunung    Gunung   @relation(fields: [gunungId], references: [id])
  
  @@map("booking_terms")
}

model Jalur {
  id                    String   @id @default(uuid())
  mountainId            String   @map("mountain_id")
  name                  String
  description           String?
  difficultyLevel       String?  @map("difficulty_level")
  estimatedDurationHours Int?    @map("estimated_duration_hours")
  maxAltitude           Int?     @map("max_altitude")
  createdAt             DateTime @default(now()) @map("created_at")
  
  // Relations
  mountain              Gunung   @relation(fields: [mountainId], references: [id])
  bookings              Booking[]
  
  @@map("trails")
}

model Booking {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  mountainId      String?  @map("mountain_id")
  trailId         String?  @map("trail_id")
  tanggalMasuk    DateTime @map("tanggal_masuk")
  tanggalKeluar   DateTime @map("tanggal_keluar")
  jumlahPemesan   Int      @map("jumlah_pemesan")
  totalHarga      Int      @map("total_harga")
  status          String   @default("pending")
  paymentStatus   String   @default("unpaid") @map("payment_status")
  specialRequests String?  @map("special_requests")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  user            User?    @relation(fields: [userId], references: [id])
  mountain        Gunung?  @relation(fields: [mountainId], references: [id])
  trail           Jalur?   @relation(fields: [trailId], references: [id])
  anggotaPemesanan AnggotaPemesanan[]
  notifications   Notifikasi[]
  
  @@map("bookings")
}

model AnggotaPemesanan {
  id              String   @id @default(uuid())
  pemesananId     String?  @map("pemesanan_id")
  email           String
  nama            String
  noIdentitas     String   @map("no_identitas")
  kewarganegaraan String   @default("Indonesia")
  jenisKelamin    String?  @map("jenis_kelamin")
  tempatLahir     String?  @map("tempat_lahir")
  tanggalLahir    DateTime? @map("tanggal_lahir")
  fileKtp         String?  @map("file_ktp")
  isCompanion     Boolean  @default(false) @map("is_companion")
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  pemesanan       Booking? @relation(fields: [pemesananId], references: [id])
  
  @@map("booking_members")
}

model GaleriGunung {
  id          String   @id @default(uuid())
  mountainId  String?  @map("mountain_id")
  imageUrl    String   @map("image_url")
  caption     String?
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  mountain    Gunung?  @relation(fields: [mountainId], references: [id])
  
  @@map("mountain_gallery")
}

model KuotaHarian {
  id              String   @id @default(uuid())
  mountainId      String?  @map("mountain_id")
  date            DateTime
  totalQuota      Int      @map("total_quota")
  bookedQuota     Int      @default(0) @map("booked_quota")
  availableQuota  Int      @default(0) @map("available_quota")
  status          String   @default("open")
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  mountain        Gunung?  @relation(fields: [mountainId], references: [id])
  
  @@map("daily_quotas")
}

model Notifikasi {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  bookingId   String?  @map("booking_id")
  title       String
  message     String
  type        String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
  
  @@map("notifications")
}


